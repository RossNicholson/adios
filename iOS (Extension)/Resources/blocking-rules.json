[
    {
        "trigger": {
            "url-filter": ".*",
            "if-domain": ["*"],
            "resource-type": ["script", "image", "style-sheet", "media"]
        },
        "action": {
            "type": "css-display-none",
            "selector": "div[id*='google_ads'], div[id*='ad-'], div[class*='ad-'], div[class*='advert'], .advertisement, ins.adsbygoogle"
        }
    },
    {
        "trigger": {
            "url-filter": ".*doubleclick\\.net.*"
        },
        "action": {
            "type": "block"
        }
    },
    {
        "trigger": {
            "url-filter": ".*google-analytics\\.com.*"
        },
        "action": {
            "type": "block"
        }
    },
    {
        "trigger": {
            "url-filter": ".*googlesyndication\\.com.*"
        },
        "action": {
            "type": "block"
        }
    },
    {
        "trigger": {
            "url-filter": ".*facebook\\.com/plugins.*",
            "resource-type": ["script", "image", "style-sheet"]
        },
        "action": {
            "type": "block"
        }
    },
    {
        "trigger": {
            "url-filter": ".*\\.doubleclick\\.net.*"
        },
        "action": {
            "type": "block"
        }
    },
    {
        "trigger": {
            "url-filter": ".*adnxs\\.com.*"
        },
        "action": {
            "type": "block"
        }
    },
    {
        "trigger": {
            "url-filter": ".*outbrain\\.com.*"
        },
        "action": {
            "type": "block"
        }
    }
] 